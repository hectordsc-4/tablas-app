# Copiar a .env en local, o definir en Coolify como variables de entorno.

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/exi_db
APP_NAME=EXI API
DEBUG=false
CORS_ORIGINS=*

# SMTP opcional (si está vacío, las contraseñas se guardan en backend/outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
