# Pegar en Coolify → tablas-app → Environment Variables (vista Developer / bulk edit).
# Activa Build Variable + Runtime Variable. Guarda y Redeploy.
# Sustituye PASSWORD y HOST_INTERNO por los del recurso Postgres (lista-viva).

DATABASE_URL=postgresql+psycopg2://listaviva:PASSWORD@HOST_INTERNO:5432/exi_db
BOOTSTRAP_DATABASE_URL=postgresql+psycopg2://listaviva:PASSWORD@HOST_INTERNO:5432/listaviva
BOOTSTRAP_DB=listaviva
APP_NAME=EXI API
DEBUG=false
CORS_ORIGINS=*
